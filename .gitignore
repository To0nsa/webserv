# =========================
# Webserv Project .gitignore
# =========================

# --- Build artifacts ---
/objs/
/deps/
/bin/
/bin/tests/
compile_commands.json

# --- Common compiled files ---
*.o
*.obj
*.lo
*.slo
*.d
*.so
*.a
*.dll
*.exe
*.out

# --- Precompiled headers ---
*.gch
*.pch

# --- Python cache ---
__pycache__/
*.pyc
*.pyo

# --- Virtual environments ---
.venv/

# --- IDE / editor settings ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS-specific metadata ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log

# --- Test temporary files ---
test_webserv/**/__pycache__/
test_webserv/**/*.pyc
test_webserv/**/*.pyo

# --- Doxygen docs ---

/docs/html/
